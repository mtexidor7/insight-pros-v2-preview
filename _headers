# Response headers for the production host (Cloudflare Pages reads this file; GitHub Pages ignores it).
# Hashed build files never change, so they can be cached for a year. Media files keep their names
# when replaced, so they get a week plus background revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
